{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datuplet.io/schemas/outputdoc-v1.json",
  "title": "OutputDoc v1",
  "type": "object",
  "required": ["outputDoc", "title", "blocks"],
  "additionalProperties": false,
  "properties": {
    "outputDoc": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "refreshInterval": {
      "type": "integer",
      "minimum": 15,
      "maximum": 3600
    }
  },
  "$defs": {
    "blockId": {
      "type": "string",
      "minLength": 1
    },
    "onClick": {
      "type": "object",
      "required": ["param"],
      "additionalProperties": false,
      "properties": {
        "param": {
          "type": "string"
        }
      }
    },
    "modal": {
      "oneOf": [
        {
          "type": "object",
          "required": ["title", "blocks"],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["param"],
          "additionalProperties": false,
          "properties": {
            "param": {
              "type": "string"
            }
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "required": ["id", "type"],
      "oneOf": [
        { "$ref": "#/$defs/markdownBlock" },
        { "$ref": "#/$defs/metricBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/chartBlock" },
        { "$ref": "#/$defs/filterBlock" },
        { "$ref": "#/$defs/tabsBlock" }
      ]
    },
    "markdownBlock": {
      "type": "object",
      "required": ["id", "type", "text"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "markdown"
        },
        "text": {
          "type": "string"
        },
        "modal": {
          "$ref": "#/$defs/modal"
        }
      }
    },
    "metricBlock": {
      "type": "object",
      "required": ["id", "type", "items"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "metric"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {},
              "format": {
                "type": "string"
              }
            }
          }
        },
        "modal": {
          "$ref": "#/$defs/modal"
        }
      }
    },
    "tableBlock": {
      "type": "object",
      "required": ["id", "type", "columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "table"
        },
        "title": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableRow"
          }
        },
        "modal": {
          "$ref": "#/$defs/modal"
        }
      }
    },
    "tableRow": {
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "object",
          "required": ["cells"],
          "additionalProperties": false,
          "properties": {
            "cells": {
              "type": "array"
            },
            "modal": {
              "$ref": "#/$defs/modal"
            }
          }
        }
      ]
    },
    "chartBlock": {
      "type": "object",
      "required": ["id", "type", "library", "spec"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "chart"
        },
        "library": {
          "const": "vega-lite"
        },
        "title": {
          "type": "string"
        },
        "spec": {
          "type": "object"
        },
        "onClick": {
          "$ref": "#/$defs/onClick"
        },
        "modal": {
          "$ref": "#/$defs/modal"
        }
      }
    },
    "filterBlock": {
      "type": "object",
      "required": ["id", "type", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "filter"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "label", "kind"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "value": {},
              "options": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/filterOption"
                }
              }
            }
          }
        },
        "modal": {
          "$ref": "#/$defs/modal"
        }
      }
    },
    "filterOption": {
      "oneOf": [
        {
          "type": ["string", "number", "boolean"]
        },
        {
          "type": "object",
          "required": ["value", "label"],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": ["string", "number", "boolean"]
            },
            "label": {
              "type": "string"
            }
          }
        }
      ]
    },
    "tabsBlock": {
      "type": "object",
      "required": ["id", "type", "tabs"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "const": "tabs"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "blocks"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/block"
                }
              }
            }
          }
        },
        "modal": {
          "$ref": "#/$defs/modal"
        }
      }
    }
  }
}
