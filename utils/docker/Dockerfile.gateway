# syntax=docker/dockerfile:1.4
#
# Data Gateway sidecar image: the datagateway binary (module gateway/, CGO,
# DuckDB data plane) with the DuckDB httpfs + iceberg extensions baked in.
#
# Same pattern as utils/docker/query-worker.Dockerfile: Debian bookworm (not
# Alpine: DuckDB's prebuilt library needs glibc), BuildKit cache mounts, a
# throwaway baker (utils/docker/install-duckdb-ext) that INSTALLs the
# extensions in the builder where the network is available.
#
# Why baked: run pods have no outbound route to extensions.duckdb.org, and the
# engine's lockdown (autoinstall/autoload off, configuration locked) forbids a
# post-boot INSTALL. The binary LOADs httpfs + iceberg from
# DATUPLET_GATEWAY_DUCKDB_EXTENSION_DIR before locking.
#
# The runtime user is uid/gid 65532: the uid the operator forces when it sets
# one (pkg/k8s/controllers, secrets/run-token mounts); the image's USER covers
# the rest. /scratch is
# the DuckDB temp_directory; the operator mounts an emptyDir over it.

FROM golang:1.25-bookworm AS builder

WORKDIR /build

# Build dependencies (CGO required for DuckDB).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    git \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Copy the full repo so the gateway module's `replace => ..` resolves.
COPY . .

WORKDIR /build/gateway
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go build -tags=duckdb_arrow -o /datagateway ./cmd/datagateway

# Bake httpfs + iceberg into /root/.duckdb/extensions. The baker binary is not
# shipped; it is reused as /ext-check in the verify stage.
WORKDIR /build/utils/docker/install-duckdb-ext
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go build -tags=duckdb_arrow -o /install-duckdb-ext . && \
    HOME=/root /install-duckdb-ext && \
    echo "Baked extension directory:" && \
    find /root/.duckdb -type f | sort

# ---- Runtime image --------------------------------------------------------
FROM debian:bookworm-slim AS runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    libstdc++6 && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -g 65532 datuplet && \
    useradd -r -u 65532 -g datuplet -d /home/datuplet -m datuplet

COPY --from=builder --chown=65532:65532 /root/.duckdb /home/datuplet/.duckdb

# DuckDB temp_directory (SettingsFromEnv default).
RUN mkdir -p /scratch && chown 65532:65532 /scratch

COPY --from=builder /datagateway /usr/local/bin/datagateway

USER 65532:65532
ENV HOME=/home/datuplet \
    DATUPLET_GATEWAY_DUCKDB_EXTENSION_DIR=/home/datuplet/.duckdb/extensions

ENTRYPOINT ["datagateway"]

# ---- Offline gate -----------------------------------------------------------
# Proves, in the runtime layout (uid 65532, HOME, libc, baked extension dir)
# with NO network, that (1) INSTALL/LOAD httpfs + iceberg succeed and (2) the
# gateway's own boot path (--selfcheck: open plane, LOAD both, lock) works.
# A mis-baked or mis-pathed extension fails the build here, not the first run.
FROM runtime AS verify
COPY --from=builder /install-duckdb-ext /ext-check
RUN --network=none /ext-check && datagateway --selfcheck && touch /tmp/ext-verified

# ---- Final image: runtime + proof the gate ran ------------------------------
FROM runtime
COPY --from=verify /tmp/ext-verified /tmp/ext-verified
